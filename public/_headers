# Cloudflare Pages applies these to every response.
# Pinned by src/test/security-headers.test.ts: the headers cannot be dropped or weakened silently.
#
# The site loads everything from its own origin: one script, one stylesheet, self-hosted fonts.
# The JSON-LD block in index.html is a data block, not an executed script, so it needs no exception.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
